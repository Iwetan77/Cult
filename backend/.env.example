# Perpl (testnet). Exchange + collateral addresses are read live from /v1/pub/context.
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
# Set only once Perpl has whitelisted it for api-key enrollment.
PERPL_ORIGIN=

# Alchemy Monad testnet RPC. Falls back to the public RPC if unset.
ALCHEMY_MONAD_RPC_URL=

# 32 bytes hex. Seals member api-key secrets at rest.
KEY_ENCRYPTION_SECRET=

DB_PATH=data/cult.db
PORT=8787
CORS_ORIGINS=http://localhost:3000
# Where share links point (the frontend).
PUBLIC_APP_URL=http://localhost:3000

# Privy: access-token verification (JWKS) + embedded-wallet lookup + policies.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Backend authorization key (P-256, base64 PKCS8, no PEM headers) and the 1-of-1
# key quorum it's registered in. Members add this quorum as a signer on their
# wallet, under the policy from GET /v1/privy/signer.
PRIVY_BACKEND_AUTH_KEY=
PRIVY_BACKEND_KEY_QUORUM_ID=

# Shared with the indexer out of band. Guards /v1/indexer/*.
INDEXER_API_KEY=
# The indexer's GraphQL (Envio/Hasura) for members' verified track record. Optional.
INDEXER_GRAPHQL_URL=
INDEXER_GRAPHQL_SECRET=

# How meme buys are paid: ausd (swap via Kuru Flow; mainnet default) or mon (testnet default).
NADFUN_PAY_WITH=
# MON never spent by the backend, so a member can always exit (Monad charges the full gas limit).
NADFUN_GAS_RESERVE_MON=0.25

# PROVISIONAL, product hasn't set it. See CONTRACTS.md.
MIRROR_OPT_OUT_SECONDS=20

# Test-only: throwaway testnet wallet holding MON + testnet AUSD. The e2e
# scripts fund fresh wallets from it. Never a real key.
FUNDER_PRIVATE_KEY=
